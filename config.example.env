# glm-switch config: copy to ~/.config/glm-switch/config.env on the head Spark and fill in this cluster's values.
# Read by bin/glm-switch (sourced as bash) and web/glm-switch-web.py (KEY=value lines).

# The TensorFold GLM-5.3 recipe's folder on the head (its .env holds ABLIT= and HF_TOKEN=)
RECIPE_DIR="$HOME/GLM-5.3-Flash-EXL3-2x-DGX-Sparks-TensorFold"
# The model server on the head
API_URL="http://127.0.0.1:8888"
# ssh targets of the worker Sparks, over their CX7 links (key-based ssh from the head)
WORKERS="admin@192.0.2.1 admin@192.0.2.3"
# How to run a command as root: "sudo -n" with a NOPASSWD rule, or bin/rootsh (docker group, no password)
ROOT_CMD="sudo -n"

# The web page: its port, the names it may be reached by (anything else gets 421), and the Sparks it shows:
# "name|ssh target|role" entries separated by ";", the head first with "local" as its target
WEB_PORT=8891
WEB_HOSTS="203.0.113.10 192.168.1.20 spark-head spark-head.local"
NODES="spark-head|local|head, rank 0; spark-w1|admin@192.0.2.1|rank 1; spark-w2|admin@192.0.2.3|rank 2"
# Names for the model server's clients on the page and in `glm-switch conns`: "ip=name" entries separated by spaces
CLIENTS="203.0.113.16=Atlas 203.0.113.43=Mac"
# MB/s on the ring cables below which a prompt that should be loading counts as not moving (3 Sparks read a prompt
# at ~2300; a lone reply moves ~500). After 30 s below it the page says the engine stalled.
CABLE_PREFILL_MB_S=1000
